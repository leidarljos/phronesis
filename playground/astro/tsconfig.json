{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["src/lib/*"],
      "@components/*": ["src/components/*"]
    },
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "astro.config.mjs"]
}
