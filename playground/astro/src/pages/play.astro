---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlaygroundIsland from "../components/PlaygroundIsland";

const fixtureId = Astro.url.searchParams.get("fixture") ?? undefined;
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Play · grok-policyd" wide>
  <h1>Play</h1>
  <p class="muted">
    Probe Cap&apos;n methods against the seeded MEMFS pack, or Author pack files and reload.
  </p>
  <PlaygroundIsland client:only="preact" initialFixtureId={fixtureId} baseUrl={base} />
</BaseLayout>
